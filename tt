#!/usr/bin/env bash
set -euo pipefail

ROOT="$(pwd)"
TASKS_DIR="$ROOT/tasks"
TOPICS_DIR="$ROOT/topics"
ARCHIVE_DIR="$ROOT/archive"
MEETING_MINUTES_DIR="$ROOT/meeting-minutes"
ACTIVE_FILE="$TASKS_DIR/active.md"
TEMPLATE_FILE="$TOPICS_DIR/template/index.md"

# Terminal styling (falls back to plain text when colors are unsupported).
RESET=""
BOLD=""
DIM=""
RED=""
GREEN=""
YELLOW=""
BLUE=""
CYAN=""

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  if [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
    RESET="$(tput sgr0)"
    BOLD="$(tput bold)"
    DIM="$(tput dim)"
    RED="$(tput setaf 1)"
    GREEN="$(tput setaf 2)"
    YELLOW="$(tput setaf 3)"
    BLUE="$(tput setaf 4)"
    CYAN="$(tput setaf 6)"
  fi
fi

msg_info() { printf "%b\n" "${BLUE}[info]${RESET} $*"; }
msg_ok() { printf "%b\n" "${GREEN}[ok]${RESET} $*"; }
msg_warn() { printf "%b\n" "${YELLOW}[warn]${RESET} $*"; }
msg_error() { printf "%b\n" "${RED}[error]${RESET} $*" >&2; }

section() {
  printf "\n%b\n" "${BOLD}${CYAN}$1${RESET}"
}

usage() {
  section "tt - Tasks and Topics"
  printf "%b\n" "${BOLD}Usage${RESET}"
  printf "  tt init\n"
  printf "  tt add task [-p high|medium|low] \"task text\"\n"
  printf "  tt add topic \"topic name\"\n"
  printf "  tt ls tasks\n"
  printf "  tt ls topics\n"
  printf "  tt done <task-number>\n"
  printf "  tt archive topic <topic-folder>\n"
  printf "  tt mm [\"meeting title\"]\n"
  printf "  tt apply\n"
  printf "  tt help\n"
}

init_repo() {
  mkdir -p "$TASKS_DIR" "$TOPICS_DIR/template" "$ARCHIVE_DIR"

  if [[ ! -f "$ACTIVE_FILE" ]]; then
    cat >"$ACTIVE_FILE" <<'EOF'
# Active Tasks

## High Priority

## Medium Priority

## Low Priority
EOF
  fi

  if [[ ! -f "$TEMPLATE_FILE" ]]; then
    cat >"$TEMPLATE_FILE" <<'EOF'
# Topic: Template topic

**Started:** 2026-06-22
**Priority:** Medium

---

## Overview

...

---

## Key Goals

- [ ] ...

---

## Notes

- ...
EOF
  fi

  msg_ok "Initialized task/topic structure in $ROOT"
}

normalize_priority() {
  case "${1,,}" in
    high) echo "High" ;;
    medium) echo "Medium" ;;
    low) echo "Low" ;;
    *) echo "" ;;
  esac
}

insert_task() {
  local priority="$1"
  local text="$2"
  local topic_link="${3:-}"
  local section="## ${priority} Priority"
  local tmp
  tmp="$(mktemp)"

  awk -v section="$section" -v task="- [ ] $text" -v link="$topic_link" '
    {
      print
      if ($0 == section && !inserted) {
        if (link != "") {
          print task " " link
        } else {
          print task
        }
        inserted = 1
      }
    }
    END {
      if (!inserted) {
        print ""
        print section
        if (link != "") {
          print task " " link
        } else {
          print task
        }
      }
    }
  ' "$ACTIVE_FILE" >"$tmp"

  mv "$tmp" "$ACTIVE_FILE"
}

add_task() {
  mkdir -p "$TASKS_DIR"
  [[ -f "$ACTIVE_FILE" ]] || init_repo >/dev/null

  local priority="Medium"
  if [[ "${1:-}" == "-p" || "${1:-}" == "--priority" ]]; then
    local parsed
    parsed="$(normalize_priority "${2:-}")"
    [[ -n "$parsed" ]] || { msg_error "Invalid priority: ${2:-}"; exit 1; }
    priority="$parsed"
    shift 2
  fi

  local text="${*:-}"
  [[ -n "$text" ]] || { msg_error "Missing task text"; usage; exit 1; }

  # Ask for related topic
  section "Select Related Topic"

  local -a topics
  mapfile -t topics < <(find "$TOPICS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name template -printf '%f\n' | sort -r | head -8)

  local topic_link=""
  local create_option=$(( ${#topics[@]} + 1 ))
  if [[ ${#topics[@]} -gt 0 ]]; then
    for i in "${!topics[@]}"; do
      printf "  %b\n" "${DIM}$((i+1)))${RESET} ${topics[$i]}"
    done
  else
    printf "  %b\n" "${DIM}(no existing topics)${RESET}"
  fi

  printf "\n"
  printf "  %b\n" "${DIM}0)${RESET} No topic"
  printf "  %b\n\n" "${DIM}${create_option})${RESET} Create new topic"

  local selection
  read -r -p "Select topic [0-${create_option}]: " selection

  if [[ "$selection" =~ ^[0-9]+$ ]]; then
    if [[ "$selection" -gt 0 && "$selection" -le ${#topics[@]} ]]; then
      local topic_name="${topics[$((selection-1))]}"
      topic_link="- [Related: $topic_name](../topics/$topic_name/index.md)"
    elif [[ "$selection" -eq "$create_option" ]]; then
      local new_topic_name
      read -r -p "New topic name: " new_topic_name
      [[ -n "$new_topic_name" ]] || { msg_error "Topic name cannot be empty"; exit 1; }

      add_topic "$new_topic_name" >/dev/null
      local new_topic_folder
      new_topic_folder="$(date +%F)-$(slugify "$new_topic_name")"
      topic_link="- [Related: $new_topic_folder](../topics/$new_topic_folder/index.md)"
      msg_ok "Created and linked topic: $new_topic_folder"
    fi
  elif [[ "$selection" == "" ]]; then
    msg_warn "No selection provided. Proceeding without topic."
  else
    msg_error "Invalid selection: $selection"
    exit 1
  fi

  insert_task "$priority" "$text" "$topic_link"
  if [[ -n "$topic_link" ]]; then
    msg_ok "Added ${priority} task: $text"
    printf "   %b\n" "${DIM}Linked to:${RESET} ${topic_link#*: }"
  else
    msg_ok "Added ${priority} task: $text"
  fi
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

add_topic() {
  mkdir -p "$TOPICS_DIR"
  local name="${*:-}"
  [[ -n "$name" ]] || { msg_error "Missing topic name"; usage; exit 1; }

  local date slug dir index
  date="$(date +%F)"
  slug="$(slugify "$name")"
  [[ -n "$slug" ]] || { msg_error "Topic name produced empty slug"; exit 1; }

  dir="$TOPICS_DIR/$date-$slug"
  index="$dir/index.md"

  [[ ! -e "$dir" ]] || { msg_error "Topic already exists: $dir"; exit 1; }
  mkdir -p "$dir"

  if [[ -f "$TEMPLATE_FILE" ]]; then
    awk -v title="$name" -v d="$date" '
      {
        if ($0 ~ /^# Topic:/ && !doneTitle) { print "# Topic: " title; doneTitle=1; next }
        if ($0 ~ /^\*\*Started:\*\*/ && !doneDate) { print "**Started:** " d; doneDate=1; next }
        print
      }
      END {
        if (!doneTitle) print "# Topic: " title
        if (!doneDate) print "**Started:** " d
      }
    ' "$TEMPLATE_FILE" >"$index"
  else
    cat >"$index" <<EOF
# Topic: $name

**Started:** $date
**Priority:** Medium

---

## Overview

...

---

## Key Goals

- [ ] ...
EOF
  fi

  msg_ok "Created topic: $dir/index.md"
}

ls_tasks() {
  [[ -f "$ACTIVE_FILE" ]] || { msg_error "No active tasks file. Run: tt init"; exit 1; }

  section "Active Tasks"
  awk -v c_high="${RED}" -v c_med="${YELLOW}" -v c_low="${CYAN}" -v c_reset="${RESET}" '
    /^## High Priority$/ { prio="High"; next }
    /^## Medium Priority$/ { prio="Medium"; next }
    /^## Low Priority$/ { prio="Low"; next }
    /^- \[ \] / {
      c++
      label=""
      if (prio == "High") label=c_high "HIGH" c_reset
      else if (prio == "Medium") label=c_med "MED" c_reset
      else label=c_low "LOW" c_reset

      printf "%2d) [%-4s] %s\n", c, label, substr($0, 7)
    }
    END {
      if (c == 0) print "No active tasks."
    }
  ' "$ACTIVE_FILE"
}

ls_topics() {
  [[ -d "$TOPICS_DIR" ]] || { msg_error "No topics directory. Run: tt init"; exit 1; }

  section "Topics"
  local -a topics
  mapfile -t topics < <(find "$TOPICS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name template -printf '%f\n' | sort)

  if [[ ${#topics[@]} -eq 0 ]]; then
    printf "%s\n" "No topics yet."
    return
  fi

  local i=1
  local topic
  for topic in "${topics[@]}"; do
    printf "%2d) %s\n" "$i" "$topic"
    ((i++))
  done
}

done_task() {
  [[ -f "$ACTIVE_FILE" ]] || { msg_error "No active tasks file. Run: tt init"; exit 1; }
  local n="${1:-}"
  [[ "$n" =~ ^[0-9]+$ ]] || { msg_error "Usage: tt done <task-number>"; exit 1; }

  local line task_text
  line="$(awk -v n="$n" '/^- \[ \] /{c++; if(c==n){print NR; exit}}' "$ACTIVE_FILE")"
  [[ -n "$line" ]] || { msg_error "No task number $n"; exit 1; }

  # Extract the task text
  task_text="$(sed -n "${line}p" "$ACTIVE_FILE" | sed 's/^- \[ \] //')"

  # Create done.md if it doesn't exist
  local done_file="$TASKS_DIR/done.md"
  if [[ ! -f "$done_file" ]]; then
    cat >"$done_file" <<'EOF'
# Completed Tasks

EOF
  fi

  # Add task to done.md with today's date
  local date
  date="$(date +%F)"
  echo "- [x] $task_text _(completed: $date)_" >> "$done_file"

  # Remove task from active.md
  sed -i "${line}d" "$ACTIVE_FILE"
  msg_ok "Task #$n moved to done.md"
}

add_meeting_minutes() {
  local name="${*:-}"

  if [[ -z "$name" ]]; then
    read -r -p "Meeting title: " name
    [[ -n "$name" ]] || { msg_error "Meeting title cannot be empty"; exit 1; }
  fi

  section "Select Topic For Meeting Minutes"

  local -a topics
  mapfile -t topics < <(find "$TOPICS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name template -printf '%f\n' | sort -r | head -8)

  local create_option=$(( ${#topics[@]} + 1 ))
  if [[ ${#topics[@]} -gt 0 ]]; then
    for i in "${!topics[@]}"; do
      printf "  %b\n" "${DIM}$((i+1)))${RESET} ${topics[$i]}"
    done
  else
    printf "  %b\n" "${DIM}(no existing topics)${RESET}"
  fi

  printf "\n"
  printf "  %b\n" "${DIM}0)${RESET} No topic (root meeting-minutes/)"
  printf "  %b\n\n" "${DIM}${create_option})${RESET} Create new topic"

  local selection
  read -r -p "Select topic [0-${create_option}]: " selection

  local mm_dir
  if [[ "$selection" =~ ^[0-9]+$ ]]; then
    if [[ "$selection" -gt 0 && "$selection" -le ${#topics[@]} ]]; then
      local topic_name="${topics[$((selection-1))]}"
      mm_dir="$TOPICS_DIR/$topic_name/meeting-minutes"
    elif [[ "$selection" -eq "$create_option" ]]; then
      local new_topic_name
      read -r -p "New topic name: " new_topic_name
      [[ -n "$new_topic_name" ]] || { msg_error "Topic name cannot be empty"; exit 1; }
      add_topic "$new_topic_name" >/dev/null
      local new_topic_folder
      new_topic_folder="$(date +%F)-$(slugify "$new_topic_name")"
      mm_dir="$TOPICS_DIR/$new_topic_folder/meeting-minutes"
      msg_ok "Created and linked topic: $new_topic_folder"
    else
      mm_dir="$MEETING_MINUTES_DIR"
    fi
  else
    if [[ -n "$selection" ]]; then
      msg_warn "Invalid selection '$selection'. Using root meeting-minutes/."
    fi
    mm_dir="$MEETING_MINUTES_DIR"
  fi

  mkdir -p "$mm_dir"

  local date slug filename filepath
  date="$(date +%F)"
  slug="$(slugify "$name")"
  filename="${date}-${slug}.md"
  filepath="$mm_dir/$filename"

  [[ ! -e "$filepath" ]] || { msg_error "File already exists: $filepath"; exit 1; }

  cat >"$filepath" <<EOF
# Meeting Minutes: $name

**Date:** $date
**Attendees:** 

---

## Agenda

- 

---

## Discussion

- 

---

## Action Items

- [ ] 

---

## Notes

- 
EOF

  msg_ok "Created meeting minutes: $filepath"
}

archive_topic() {
  local topic="${1:-}"
  [[ -n "$topic" ]] || { msg_error "Usage: tt archive topic <topic-folder>"; exit 1; }

  local src="$TOPICS_DIR/$topic"
  local dst="$ARCHIVE_DIR/$topic"

  [[ -d "$src" ]] || { msg_error "Topic not found: $src"; exit 1; }
  mkdir -p "$ARCHIVE_DIR"
  [[ ! -e "$dst" ]] || { msg_error "Archive target already exists: $dst"; exit 1; }

  mv "$src" "$dst"
  msg_ok "Archived topic: $topic"
}

apply_changes() {
  cd "$ROOT"
  git add -A
  git commit -m "Update: tasks and topics" || { msg_info "Nothing to commit"; exit 0; }
  git push || { msg_error "Failed to push"; exit 1; }
  msg_ok "Changes committed and pushed"
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then
    ls_tasks
    return
  fi
  shift || true

  case "$cmd" in
    init)
      init_repo
      ;;
    add)
      case "${1:-}" in
        task) shift; add_task "$@" ;;
        topic) shift; add_topic "$@" ;;
        *) usage; exit 1 ;;
      esac
      ;;
    ls)
      case "${1:-}" in
        tasks) ls_tasks ;;
        topics) ls_topics ;;
        *) usage; exit 1 ;;
      esac
      ;;
    done)
      done_task "$@"
      ;;
    mm)
      add_meeting_minutes "$@"
      ;;
    archive)
      [[ "${1:-}" == "topic" ]] || { usage; exit 1; }
      shift
      archive_topic "$@"
      ;;
    apply)
      apply_changes
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      add_task "$cmd" "$@"
      ;;
  esac
}

main "$@"
